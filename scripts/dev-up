#!/bin/sh
set -eu

command -v bws >/dev/null 2>&1 || { echo "bws is required" >&2; exit 127; }
: "${BWS_ACCESS_TOKEN:?BWS_ACCESS_TOKEN must be set externally}"
project_id="c9396036-41e9-4de4-a845-b4b600d86900"

exec bws run --project-id "$project_id" -- 'cd /home/dwovitz/src/ai/memory-mcp && docker compose -f docker-compose.yml -f .secret-migrate.compose.yaml up -d'
