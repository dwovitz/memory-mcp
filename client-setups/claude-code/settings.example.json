{
  "mcpServers": {
    "memory-mcp": {
      "command": "docker",
      "args": [
        "compose",
        "-f",
        "/home/dwovitz/src/ai/memory-mcp/docker-compose.yml",
        "exec",
        "-T",
        "memory-mcp",
        "memory-mcp"
      ],
      "cwd": "/home/dwovitz/src/ai/memory-mcp"
    },
    "code-review-graph": {
      "command": "code-review-graph",
      "args": [
        "serve"
      ],
      "type": "stdio",
      "timeout": 300000
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__memory-mcp__get_context_packet",
        "hooks": [
          {
            "type": "command",
            "command": "echo memory-mcp context packet requested >> $HOME/memory-mcp-hooks.log"
          }
        ]
      }
    ]
  }
}
