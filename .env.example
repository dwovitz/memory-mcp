POSTGRES_DB=memory_mcp
POSTGRES_HOST=127.0.0.1
POSTGRES_USER=memory_mcp
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
POSTGRES_BIND_HOST=127.0.0.1

# Windows host bind mount for durable PostgreSQL data.
# Create this folder before starting Docker Compose.
PGDATA_HOST_PATH=C:\ai\memory-postgres-data

# MCP safety gates. Leave both false for read-only normal-sensitivity use.
MEMORY_MCP_ENABLE_MUTATION_TOOLS=false
MEMORY_MCP_ENABLE_SENSITIVE_TOOLS=false
