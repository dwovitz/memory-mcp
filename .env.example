POSTGRES_DB=memory_mcp
POSTGRES_HOST=127.0.0.1
POSTGRES_USER=memory_mcp
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
POSTGRES_BIND_HOST=127.0.0.1

# MIG-001 step 38/39: native-Linux bind mount for durable PostgreSQL data — must stay on ext4,
# never under /mnt. Create this folder before starting Docker Compose; ownership must match what
# the pgvector/postgres image's internal user can write (step 43 — the image keeps its own user,
# do not chown this to David's UID).
PGDATA_HOST_PATH=/home/dwovitz/src/ai/memory-mcp/.pgdata

# MCP safety gates. Mutation tools are enabled for the local Docker-backed workflow.
MEMORY_MCP_ENABLE_MUTATION_TOOLS=true
MEMORY_MCP_ENABLE_SENSITIVE_TOOLS=false

# Auth mode defaults to trusted local stdio. Set remote for any hosted/shared
# HTTP, HTTPS, gateway, reverse-proxy, SSE, or WebSocket deployment.
MEMORY_MCP_AUTH_MODE=trusted_local
MEMORY_MCP_OIDC_ISSUER=
MEMORY_MCP_OIDC_AUDIENCE=
MEMORY_MCP_AUTH_GLOBAL_ACCESS_GROUPS=
MEMORY_MCP_AUTH_MUTATION_GROUPS=
MEMORY_MCP_AUTH_SENSITIVE_GROUPS=
MEMORY_MCP_AUTH_SENSITIVE_ECHO_GROUPS=
MEMORY_MCP_AUTH_ADMIN_GROUPS=
MEMORY_MCP_AUTH_PROJECT_GRANTS_JSON=
MEMORY_MCP_TRUSTED_PROXY_ENABLED=false
MEMORY_MCP_TRUSTED_PROXY_ISSUER=
